rules_version = '2';

// Security rules for watplay. Paste these into Firebase console > Firestore >
// Rules, or deploy them with `firebase deploy --only firestore:rules`.
//
// groups/{slug}  is a public directory entry. It can be read by name but
//                never listed, and is fixed once created.
// spaces/{key}   holds a group's data. The key is a SHA-256 of the group name
//                and password, so it can only be found by people who know the
//                password. Listing is forbidden, so keys can't be discovered.
service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{slug} {
      allow get: if true;
      allow list: if false;
      allow create: if slug.matches('^[a-z0-9-]{1,60}$')
        && request.resource.data.keys().hasOnly(['name', 'protected', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.protected is bool;
      allow update, delete: if false;
    }

    match /spaces/{key} {
      allow get: if true;
      allow list: if false;
      allow create, update: if key.matches('^[0-9a-f]{64}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 1000
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 50
        && request.resource.data.cats is list
        && request.resource.data.cats.size() <= 50;
      allow delete: if false;
    }
  }
}
